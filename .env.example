# Telegram Bot Token
# 从 @BotFather 获取你的 Bot Token
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# 远程 Telegram Bot API 服务器配置
# Bot API 服务器地址
BOT_API_HOST=https://your-bot-api-host.com/bot-api/

# 公网文件访问基础 URL（用于下载文件）
PUBLIC_FILE_BASE_URL=https://your-public-file-base-url.com/bot-api-files

# Telegram Bot 基础目录（可选，默认 /media/TGbot）
TG_BASE_DIR=/home/your-username