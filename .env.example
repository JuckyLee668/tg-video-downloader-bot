# Telegram Bot Token
BOT_TOKEN=你的BotToken

# Telegram User API (从 https://my.telegram.org 申请)
USER_API_ID=你的API_ID
USER_API_HASH=你的API_HASH

# Web server
WEB_HOST=127.0.0.1
WEB_PORT=8000
WEB_CORS_ORIGINS=*

# Web API key
WEB_API_KEY=你的密钥

# Mini App 外网地址 (Cloudflare Tunnel)
# 启动 tunnel 后填入: https://xxx.trycloudflare.com
# MINI_APP_URL=
