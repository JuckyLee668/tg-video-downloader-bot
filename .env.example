# Telegram Bot Token
# 从 @BotFather 获取你的 Bot Token
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# 远程 Telegram Bot API 服务器配置
# Bot API 服务器地址
BOT_API_HOST=https://your-bot-api-host.com/bot-api/

# 公网文件访问基础 URL（用于下载文件）
PUBLIC_FILE_BASE_URL=https://your-public-file-base-url.com/bot-api-files

# Telegram Bot 基础目录（可选，默认 /media/TGbot）
TG_BASE_DIR=/home/your-username

# 普通 Telegram 客户端配置（可选，用于频道历史搜索和下载）
# 如果希望 Bot 可以访问频道历史消息并下载不可转发的媒体，
# 请到 https://my.telegram.org 申请 api_id 和 api_hash
USER_API_ID=YOUR_API_ID_HERE
USER_API_HASH=YOUR_API_HASH_HERE